# Leave EMPTY (recommended). The Vite proxy forwards /api → backend:8000
# and keeps refresh cookies same-origin.
#
# DO NOT set this to the frontend URL (e.g. http://127.0.0.1:5173).
# If you must call the API directly, use the backend origin only:
# VITE_API_BASE_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=
