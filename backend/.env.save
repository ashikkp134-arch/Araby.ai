MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=ai_coding_workspace
REDIS_URL=redis://localhost:6379/0

# Generate your own secrets (min 32 characters each). Do not reuse these defaults in production.
JWT_SECRET=replace-with-a-long-random-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret-at-least-32-chars

# Required for AI chat / code generation
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Hybrid routing: light = explanations/docs; coding = multi-file edits (fallback = OPENAI_MODEL)
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_CODING=gpt-4o-mini
# Leave empty for OpenAI. For OpenAI-compatible hosts (e.g. xAI Grok) set e.g. https://api.x.ai/v1
OPENAI_BASE_URL=
LLM_PROVIDER=openai

ACCESS_TOKEN_EXPIRE=15
REFRESH_TOKEN_EXPIRE=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
RATE_LIMIT_LOGIN=5
APP_ENV=development
APP_NAME=AI Coding Workspace
LOG_LEVEL=INFO




