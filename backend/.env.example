MONGO_URI=mongodb://localhost:27017
DATABASE_NAME=ai_coding_workspace
REDIS_URL=redis://localhost:6379/0

# Generate your own secrets (min 32 characters each). Do not reuse these defaults in production.
JWT_SECRET=5138e5f0218eb09e499f7af0be4acd50492e92c234c600dba3811de25437c24a
JWT_REFRESH_SECRET=13037b962cd13d000944f4596e09b20e9cd75a8caaa4a99d4fa84c6cfae99079

# Required for AI chat / code generation
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
# Hybrid routing: light = explanations/docs; coding = multi-file edits (fallback = OPENAI_MODEL)
OPENAI_MODEL_LIGHT=gpt-4o-mini
OPENAI_MODEL_CODING=gpt-4o
# Leave empty for OpenAI. For OpenAI-compatible hosts (e.g. xAI Grok) set e.g. https://api.x.ai/v1
OPENAI_BASE_URL=
LLM_PROVIDER=openai

ACCESS_TOKEN_EXPIRE=15
REFRESH_TOKEN_EXPIRE=10080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
RATE_LIMIT_LOGIN=5
APP_ENV=development
APP_NAME=AI Coding Workspace
LOG_LEVEL=INFO

# OpenTelemetry / OpenInference
# For local/dev without a valid Phoenix key, set OTEL_ENABLED=false to silence export noise.
OTEL_ENABLED=true
# Local Phoenix (no API key):
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:6006/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=https://app.phoenix.arize.com/s/AI-Coding-Workspace/v1/traces
# Optional: Authorization=Bearer <token>  (prefer PHOENIX_API_KEY below)
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=araby-codeai-backend
# Phoenix Cloud (when set, collector endpoint takes precedence over OTEL endpoint):
PHOENIX_COLLECTOR_ENDPOINT=
PHOENIX_PROJECT=AI-Coding-Workspace
PHOENIX_API_KEY=

# LLM input/output guardrails
GUARDRAILS_ENABLED=true
GUARDRAILS_BLOCK_ON_INPUT=true
GUARDRAILS_BLOCK_ON_OUTPUT=true

# After website generation, auto-repair missing Live Preview imports (max attempts)
PREVIEW_REPAIR_MAX_RETRIES=3

# Asset Resolution Service — discovers/validates images BEFORE the LLM generates code.
# Unsplash/Pexels are optional; Wikimedia + curated Unsplash CDN URLs are used as fallbacks.
ASSET_RESOLUTION_ENABLED=true
ASSET_RESOLUTION_VALIDATE=true
ASSET_RESOLUTION_PER_ROLE=4
# Max seconds for image search plus OpenAI semantic verification.
ASSET_RESOLUTION_BUDGET_SECONDS=30
# OpenAI vision validates topic relevance and exact named-person identity.
ASSET_SEMANTIC_VERIFICATION_ENABLED=true
OPENAI_IMAGE_VERIFICATION_MODEL=gpt-4o-mini
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
